[
  {
    "name": "zendesk_read_ticket",
    "description": "Retrieve a Zendesk support ticket by ID, including status, requester, and conversation history",
    "category": "zendesk",
    "parameters": {
      "type": "object",
      "properties": {
        "ticket_id": {
          "type": "string",
          "description": "The Zendesk ticket ID"
        }
      },
      "required": ["ticket_id"]
    }
  },
  {
    "name": "stripe_list_subscriptions",
    "description": "List active Stripe subscriptions for a customer, including plan details and billing status",
    "category": "stripe",
    "parameters": {
      "type": "object",
      "properties": {
        "customer_id": {
          "type": "string",
          "description": "The Stripe customer ID"
        },
        "status": {
          "type": "string",
          "description": "Filter by subscription status",
          "enum": ["active", "past_due", "canceled", "all"],
          "default": "active"
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of subscriptions to return",
          "default": 10,
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": ["customer_id"]
    }
  },
  {
    "name": "stripe_issue_refund",
    "description": "Issue a refund for a Stripe charge or payment intent",
    "category": "stripe",
    "parameters": {
      "type": "object",
      "properties": {
        "payment_id": {
          "type": "string",
          "description": "The Stripe charge or payment intent ID to refund"
        },
        "amount": {
          "type": "number",
          "description": "Refund amount in the currency's smallest unit (e.g. cents). Omit for full refund.",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "description": "Reason for the refund",
          "enum": ["duplicate", "fraudulent", "requested_by_customer"]
        }
      },
      "required": ["payment_id"]
    },
    "compliance": {
      "level": "restricted",
      "requires_approval": true,
      "data_tags": ["financial"]
    }
  },
  {
    "name": "zendesk_add_comment",
    "description": "Add an internal or public comment to a Zendesk ticket",
    "category": "zendesk",
    "parameters": {
      "type": "object",
      "properties": {
        "ticket_id": {
          "type": "string",
          "description": "The Zendesk ticket ID"
        },
        "body": {
          "type": "string",
          "description": "The comment text"
        },
        "public": {
          "type": "boolean",
          "description": "Whether the comment is visible to the requester",
          "default": false
        }
      },
      "required": ["ticket_id", "body"]
    }
  }
]
